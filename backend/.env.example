# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# Database. Defaults to local SQLite. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/student_tracker
DATABASE_URL=sqlite:///./student_tracker.db

# Comma-separated allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Where verification links point (the frontend)
FRONTEND_URL=http://127.0.0.1:5173

# Email verification: if SMTP_HOST is unset, verification links are printed
# to the backend console (dev mode). Set these to send real email:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASSWORD=your-password
# SMTP_FROM=no-reply@yourdomain.com
