# Docker Compose reads variables from a file named `.env` in this project root.
# Copy this file to `.env` and replace the placeholders.

SECRET_KEY=change-me-to-a-long-random-value
FRONTEND_URL=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000

# Clerk handles signup, login, email verification, and password reset.
# Find these in Clerk Dashboard -> API keys.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_JWKS_URL=https://your-clerk-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173

# Gmail SMTP example:
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password for Mail.
# 3. Use that 16-character app password here, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=yourgmail@gmail.com
